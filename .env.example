# Identity Backend (identity-api) - plantilla sin secretos (copiar como .env y completar)
# Formato de Dokploy (Environment): una variable por línea. "#" inicia un comentario, así que todo valor que
# contenga "#" va entre comillas dobles. Las secciones de .NET se separan con "__" (Messaging__Evolution__Url).
# Lo que no está aquí viene de appsettings.Production.json. Guía: docs/requerimiento/despliegue-dokploy.md.

# Base de datos (Identity Database > General > Internal Credentials)
ConnectionStrings__Default="Host=<host-interno-identity-db>;Port=5432;Database=Identity;Username=postgres;Password=<contraseña>"

# Firma de tokens: archivo montado en Advanced > Volumes > File Mount
Jwt__SigningKey__PemPath=/run/secrets/identity-signing-key.pem

# Cliente de servicio de Sheepfold para el directorio de cuentas (mismo secreto que IdentityDirectory__ClientSecret)
Jwt__ServiceClients__0__ClientId=sheepfold-api
Jwt__ServiceClients__0__Secret=<secreto de 32+ caracteres>

# Primer administrador: solo se usa si no existe ninguno. La contraseña ya no hace falta (el administrador existe).
Bootstrap__Admin__UserName=admin
Bootstrap__Admin__PhoneNumber=+570000000000

# WhatsApp con Evolution API (docs/requerimiento/whatsapp-evolution.md)
Messaging__Evolution__Url=https://evolution.tmtbucaramanga.com
Messaging__Evolution__Instance=tmt-bucaramanga
Messaging__Evolution__ApiKey="<token de la instancia>"
