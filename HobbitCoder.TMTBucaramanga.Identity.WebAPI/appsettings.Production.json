{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "PostgreSQL"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://sheepfold.tmtbucaramanga.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type"
    ],
    "ExposedHeaders": [
      "Location",
      "WWW-Authenticate"
    ],
    "AllowCredentials": false,
    "MaxAgeInSeconds": 600
  },
  "Jwt": {
    "Issuer": "https://identity.tmtbucaramanga.com",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14,
    "Audiences": [
      "HobbitCoder.TMTBucaramanga.Identity",
      "HobbitCoder.TMTBucaramanga.Sheepfold"
    ],
    "Clients": [
      {
        "ClientId": "sheepfold-web",
        "Audience": "HobbitCoder.TMTBucaramanga.Sheepfold",
        "RedirectUris": [
          "https://sheepfold.tmtbucaramanga.com/auth/callback"
        ]
      }
    ]
  }
}
